  m_Name: Sleeper - Musing - Familiar - O5
  m_EditorClassIdentifier: DialogueSystem.Runtime::DialogueSystem.DialogueGraph
  nodes:
  - guid: 1ca3d04b-af85-46b5-b33f-8a34b969f610
    kind: 3
