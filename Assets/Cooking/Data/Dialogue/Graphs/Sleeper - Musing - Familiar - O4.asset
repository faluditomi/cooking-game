  m_Name: Sleeper - Musing - Familiar - O4
  m_EditorClassIdentifier: DialogueSystem.Runtime::DialogueSystem.DialogueGraph
  nodes:
  - guid: bee05784-7e9a-4080-8a6c-ee34b9eb2672
