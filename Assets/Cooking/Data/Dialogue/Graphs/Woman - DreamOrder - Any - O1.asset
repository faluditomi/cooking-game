  m_Name: Woman - DreamOrder - Any - O1
  m_EditorClassIdentifier: DialogueSystem.Runtime::DialogueSystem.DialogueGraph
  nodes:
  - guid: 1f2dc18e-4b60-4a46-ba0e-d05c9e52776e
    kind: 3
    line:
      text: 
      delaySeconds: 1
    editorPosition: {x: 0, y: 0}
  - guid: d963c416-421a-4fd4-82c4-cb65e5140741
    kind: 0
    line:
      text: This... This is...
      delaySeconds: 0.4
    editorPosition: {x: 260, y: 0}
  - guid: d0fa48fa-45c2-4130-a2b5-a654876bcecd
    kind: 0
    line:
      text: It can't be.
      delaySeconds: 1.6
    editorPosition: {x: 520, y: 0}
  - guid: ec972893-977c-4fff-9bd3-97eb437720c2
    kind: 0
    line:
      text: I know this soup, I used to make it over and over again for...
      delaySeconds: 1.4
    editorPosition: {x: 780, y: 0}
  - guid: 906c925d-62b8-4ba5-af9e-2bb3a060cabf
    kind: 0
    line:
      text: Ohh, Jessa, where might you be be now. Why did you have to leave it all behind... Leave me behind...
      delaySeconds: 3.2
    editorPosition: {x: 1040, y: 0}
  - guid: 9ebd0a44-bb97-4638-a0d8-54a4921977e9
    kind: 0
    line:
      text: Pot Boy, who the fuck are you? Why do you know my recipe?
      delaySeconds: 4.6
    editorPosition: {x: 1300, y: 0}
  - guid: b4270593-3155-432d-ae6f-1be442fcab4e
    kind: 0
    line:
      text: The balance of sweet and sour, the thickness of the broth, and the beef!?
      delaySeconds: 3
    editorPosition: {x: 1560, y: 0}
  - guid: 4fd27614-d515-42ee-9905-5a4e749a761a
    kind: 0
    line:
      text: The beef is tender, just the way she liked it. Just the way she always was.
      delaySeconds: 3.6
    editorPosition: {x: 1820, y: 0}
  - guid: a99608a2-3cfc-4147-86f4-f1f422d53667
    kind: 0
    line:
      text: Jessa is my partner. Or, was my partner. Once the Flux events started she wanted nothing more to do with this place and left.
      delaySeconds: 3.7
    editorPosition: {x: 2080, y: 0}
  - guid: 7cef599e-a68e-402b-98ed-f55110c619b4
    kind: 0
    line:
      text: More like I let her go, the bonehead that I am.
      delaySeconds: 5.5
    editorPosition: {x: 2340, y: 0}
  - guid: e4abe4ac-aa19-4c30-9a50-b6f38edfd3fd
    kind: 0
    line:
      text: She was smart to leave and I was too caught up in the sour to see the sweetness slip away. Been caught up ever since.
      delaySeconds: 2.7
    editorPosition: {x: 2600, y: 0}
  - guid: e9fae2fd-cd6e-48d9-be6c-e166ab9f452e
    kind: 0
    line:
      text: I have to go now.
      delaySeconds: 5.2
    editorPosition: {x: 2860, y: 0}
  - guid: dd1e63b2-950b-42bc-9acb-2fe7ee5049b2
    kind: 0
    line:
      text: I have to go but I'll be back. I'm not done with you yet.
      delaySeconds: 1.6
    editorPosition: {x: 3120, y: 0}
  - guid: f2563ede-1752-4480-9495-f4680fc2b154
    kind: 4
    line:
      text: 
      delaySeconds: 1
    editorPosition: {x: 3380, y: 0}
